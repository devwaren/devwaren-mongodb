{
  "name": "@dev-waren/mongodb",
  "version": "1.0.52",
  "description": "A declarative MongoDB utility package built on the official MongoDB Node.js driver",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "mongodb": "^7.7.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.1",
    "xss": "^1.0.15",
    "zod": "^4.6.5"
  }
}